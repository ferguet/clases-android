<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Grabar el audio de la clase. Es el unico permiso delicado de toda
         esta app. SI se usa con la app minimizada -una clase dura horas y
         nadie deja el movil quieto todo ese rato- pero nunca a escondidas:
         mientras graba hay un aviso permanente en la barra de
         notificaciones con el tiempo corriendo, que Android obliga a
         mostrar y que aqui no se intenta esquivar. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- SEGUIR GRABANDO CON LA APP MINIMIZADA.
         Android permite trabajar en segundo plano solo con un servicio
         "en primer plano", que obliga a mostrar un aviso permanente. Me
         parece la condicion correcta: nada de grabar a escondidas. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <uses-feature android:name="android.hardware.microphone" android:required="true" />

    <application
        android:label="Clases"
        android:icon="@android:drawable/ic_btn_speak_now"
        android:theme="@style/Theme.AppCompat.NoActionBar"
        android:allowBackup="false"
        android:usesCleartextTraffic="true">

        <!-- usesCleartextTraffic="true": mientras el servidor viva en la
             red local de casa (http://192.168...) sin HTTPS. Cuando el
             servidor este en Render o detras de Cloudflare Tunnel con
             HTTPS, esto se puede quitar. -->

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- El que graba de verdad. Vive fuera de la pantalla para que
             minimizar la app no corte la clase por la mitad. -->
        <service
            android:name=".ServicioGrabacion"
            android:exported="false"
            android:foregroundServiceType="microphone" />

    </application>
</manifest>
